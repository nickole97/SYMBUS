# Large data files — never commit
*.fna
*.fa
*.faa
*.ffn
*.fq
*.fastq
*.gz
*.bam
*.bai
*.sam
*.zip

# Pipeline output directories (data, not scripts)
**/01_reference_genomes/
**/02_our_MAGs/
**/03_prodigal/
**/04_orthofinder/
**/05_core_OGs/
**/06_alignments/
**/07_iqtree/*
**/logs/

# Slurm logs
*.out
*.err

# Python
__pycache__/
*.pyc

# Mac
.DS_Store

# R generated outputs — never commit
*.html
*.knit.md
*_files/

# Track the final tree files (small text) but not the rest of 07_iqtree/
!**/07_iqtree/*.treefile
!**/07_iqtree/*.contree
!**/07_iqtree/*.iqtree
!**/07_iqtree/*_tip_table.tsv

# Gilliamella v2 keeps its tree under 06_iqtree: track the treefile, not the plots
**/06_iqtree/*.png
**/06_iqtree/*.pdf
